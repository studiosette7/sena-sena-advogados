ponte-whatsapp/sessao/
ponte-whatsapp/node_modules/
**/node_modules/

# Estado local do CLI do Supabase (guarda o ref do projeto).
supabase/.temp/
supabase/.branches/

# Ajustes da máquina, não do projeto.
.claude/
.DS_Store
**/.DS_Store
*.log
.env
.env.*
